# Server-to-server NetSapiens API v2 access. Use a dedicated, least-privilege token.
NS_API_BASE_URL=https://api.example.com/ns-api/v2
NS_API_TOKEN=replace-with-a-dedicated-api-token
# Optional multi-domain mode. When nonempty, this map takes precedence and rejects unlisted domains.
# Leave NS_API_TOKEN empty when using this map. All values shown here are placeholders.
# NS_API_TOKENS_BY_DOMAIN='{"tenant-a.example":"tenant-a-office-manager-key","tenant-b.example":"tenant-b-office-manager-key"}'
# The origin the phones use to reach this app. No path or trailing slash required.
PUBLIC_BASE_URL=https://voicemail.example.com
# Separate phone app key, never the NetSapiens bearer token. Generate with: npm run generate-key
PHONE_ACCESS_TOKEN=replace-with-at-least-32-random-characters
# Optional: replace ONLY loopback hosts returned in signed audio URLs.
# Use the public origin of the SAME media-serving core, not the middleware app.
MEDIA_PUBLIC_ORIGIN=
LISTEN_HOST=127.0.0.1
PORT=5000
API_TIMEOUT_MS=10000
DISPLAY_TIMEZONE=America/New_York
